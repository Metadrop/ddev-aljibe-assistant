#!/bin/bash
#ddev-generated



# Constants
DRUSH_ALIASES_FOLDER="./drush/sites"
BEHAT_LOCAL_FOLDER="./tests/behat/local"
INSTALL_DRUPAL_10="n"
PHP_VERSION="8.3"
CYAN='\033[0;36m'
NC='\033[0m' # No Color

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"


# Default values for options
AUTO=0
DEFAULT_PROJECT_CORE=11
DEFAULT_PROFILE="minimal"
TESTING_MODE=0

# Variables
declare PROJECT_CORE
declare PROJECT_NAME
declare SETUP_GIT_REPO
declare INSTALL_DRUPAL
declare INSTALL_PROFILE
declare INSTALL_ARTISAN_SUBTHEME


# Exit with an error if an option that needs a value did not get one.
#
# $1: option name.
# $2: next command line argument (the expected value), if any.
require_option_value() {
  if [[ -z "${2:-}" || "$2" == -* ]]; then
    echo "Error: option $1 requires a value."
    exit 1
  fi
}

# Parse command line arguments.
#
# Processes command line flags and options to configure project creation.
parse_arguments() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      -a|--auto)
        AUTO=1
        shift
        ;;
      -n|--name)
        require_option_value "$1" "${2:-}"
        PROJECT_NAME="$2"
        echo "Received project name: $PROJECT_NAME"
        shift 2
        ;;
      -c|--core)
        require_option_value "$1" "${2:-}"
        if [[ "$2" == "10" || "$2" == "11" ]]; then
          echo "Received Drupal core version: $2"
          PROJECT_CORE="$2"
        else
          echo "Error: Invalid Drupal core version. Only 10 or 11 are valid."
          exit 1
        fi
        shift 2
        ;;
      -e|--extensions)
        require_option_value "$1" "${2:-}"
        if [[ "$2" == "NONE" ]]; then
          PROVIDED_ALJIBE_EXTENSIONS="NONE"
          echo "Extensions to install: none"
        else
          PROVIDED_ALJIBE_EXTENSIONS="$2"
          echo "Extensions to install: $PROVIDED_ALJIBE_EXTENSIONS"
        fi
        shift 2
        ;;
      -g|--git)
        SETUP_GIT_REPO=0
        echo "Git repository will NOT be initialized"
        shift
        ;;
      -i|--install)
        INSTALL_DRUPAL=0
        echo "Drupal will NOT be installed"
        shift
        ;;
      -t|--theme)
        INSTALL_ARTISAN_SUBTHEME=1
        echo "Artisan theme will be installed and a subtheme will be created"
        shift
        ;;
      -p|--profile)
        require_option_value "$1" "${2:-}"
        INSTALL_PROFILE="$2"
        echo "Received install profile: $INSTALL_PROFILE"
        shift 2
        ;;
      --testing)
        TESTING_MODE=1
        echo "Enabling testing mode"
        shift 1
        ;;
      *)
        echo "Error: Unknown option $1"
        exit 1
        ;;
    esac
  done
}


# Create project.
#
# This function is called from the main script to create a new project.
create_project() {
  # Parse command line arguments if provided
  parse_arguments "$@"


  configure_project
  git_setup
  aljibe_extensions_setup
  ddev_start
  composer_install
  drupal_install
  behat_setup
  backstopjs_setup
  grumphp_setup
  phpunit_setup
  artifact_generator_setup
  create_subtheme
  add_custom_themes_to_aljibe
}


# Internal function to display a question.
# $1: Question text
# $2: Additional prompt text (e.g., "[Y/n]")
_question() {
  echo -en "${CYAN}$1${NC} $2 "
}

# Format a strings as a generic question.
# $1: Question text
display_question() {
  _question "$1:"
}

# Format a strings as a yes/no question.
# $1: Question text
# $2: Additional prompt text (e.g., "[y/N]")
display_yesno_question() {
  _question "$1" "${2:-[Y/n]}"
}

# Check if an answer to a yes/no question is "yes" (y or yes, any case).
# $1: answer.
answer_is_yes() {
  case "$1" in [yY] | [yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

# Check if an answer to a yes/no question is "no" (n or no, any case).
# $1: answer.
answer_is_no() {
  case "$1" in [nN] | [nN][oO]) return 0 ;; *) return 1 ;; esac
}

# Determine some choices and setup several configuration files
configure_project() {

  cd "${DDEV_APPROOT}" || exit

  # Set project name.
  if [ -z "$PROJECT_NAME" ]; then
    if [ "$AUTO" == "0" ]; then
      display_question "Please enter the project name (default to ${DDEV_PROJECT})"
      read -r PROJECT_NAME_INPUT
    fi
    PROJECT_NAME=${PROJECT_NAME_INPUT:-$DDEV_PROJECT}
  fi


  # Set core to install.
  if [ -z "$PROJECT_CORE" ]; then
    if [ "$AUTO" == "0" ]; then
      display_yesno_question "By default, Drupal 11 will be installed. Do you want to install Drupal 10 instead?" "[y/N]"
      read -r INSTALL_DRUPAL_10

      if answer_is_yes "$INSTALL_DRUPAL_10"; then
        PROJECT_CORE=10
      fi
    fi
    PROJECT_CORE=${PROJECT_CORE:-$DEFAULT_PROJECT_CORE}
  fi

  echo "Configuring DDEV environment"

  echo "Configuring ddev project $PROJECT_NAME"
  ddev config --project-type="drupal$PROJECT_CORE" --php-version "$PHP_VERSION" --project-name "$PROJECT_NAME" --docroot 'web' --auto

  echo "Preparing Aljibe config file"
  cp "${DDEV_APPROOT}/.ddev/aljibe.yaml.example" "${DDEV_APPROOT}/.ddev/aljibe.yaml"
  os_custom_sed "s/default_site\: self/default_site\: $PROJECT_NAME/g" "${DDEV_APPROOT}/.ddev/aljibe.yaml"

  echo "Copying Aljibe Kickstart project files"
  ddev aljibe-kickstart --yes "d$PROJECT_CORE"

  echo "Setting up Drush aliases file"
  cp "$DRUSH_ALIASES_FOLDER/sitename.site.yml.example" "$DRUSH_ALIASES_FOLDER/$PROJECT_NAME.site.yml"
  os_custom_sed "s/example/$PROJECT_NAME/g" "$DRUSH_ALIASES_FOLDER/$PROJECT_NAME.site.yml"

  echo "Setting up behat.yml file"
  os_custom_sed "s/example/$PROJECT_NAME/g" "$BEHAT_LOCAL_FOLDER/behat.yml"
}

# Setup git repository.
#
# Initializes a new git repository with main and develop branches, if required.
git_setup() {

  if [ -z "$SETUP_GIT_REPO" ]; then
    if [ "$AUTO" == "0" ]; then
      display_yesno_question "Do you want to initialize a git repository for your new project?"
      read -r INITIALIZE_GIT

      if answer_is_no "$INITIALIZE_GIT"; then
        SETUP_GIT_REPO=0
      fi
    fi
    SETUP_GIT_REPO=${SETUP_GIT_REPO:-1}
  fi

  if [ "$SETUP_GIT_REPO" == "1" ]; then
    ## Init with main branch
    echo "Initializing git repository"
    git init -b main
    # Create develop branch
    git checkout -b develop
  fi
}


aljibe_extensions_setup() {

  # shellcheck disable=SC2034
  local available_aljibe_extensions
  available_aljibe_extensions=(   "ddev/ddev-adminer"  "Metadrop/ddev-mkdocs"  "Metadrop/ddev-selenium"  "Metadrop/ddev-backstopjs"  "Metadrop/ddev-pa11y"  "Metadrop/ddev-unlighthouse"  "Metadrop/ddev-newman"  "Metadrop/ddev-yellowlabtools"  )

  local preselection
  # shellcheck disable=SC2034
  preselection=( "true"  "true"  "true"  "true"  "true"  "true"  "true"  "true"  )

  if [ -z "$PROVIDED_ALJIBE_EXTENSIONS" ]; then
    # If testing mode is enabled act like in auto mode because we cannot
    # interactively select options.
    if [ "$AUTO" == "0" ] && [ "$TESTING_MODE" != "1" ]; then
      _question "Please select the Aljibe extensions you want to enable for your project (space to toggle, enter to accept):"
      echo ""

      local available_aljibe_extension_labels
      # shellcheck disable=SC2034
      available_aljibe_extension_labels=(   "Adminer (Database web interface)"  "MkDocs (Documentation)"   "Behat (Acceptance tests)"  "BackstopJS (Visual regression testing)"  "Pa11y (Accessibility checker)"  "Unlighthouse (Quality, performance and correctness testing)"  "Newman (API testing)"  "Yellowlabs Tools (Performance and front-end quality issues analyzer)"  )

      multiselect result available_aljibe_extensions available_aljibe_extension_labels preselection
    else
      result=("${preselection[@]}")
    fi
  elif [ "$PROVIDED_ALJIBE_EXTENSIONS" == "NONE" ]; then
    # shellcheck disable=SC2034
    local result=()
    for extension in "${available_aljibe_extensions[@]}"; do
      result+=("false")
    done
  else
    # Convert provided extensions into a result array to behave like the user
    # selected them.
    IFS=',' read -r -a provided_extensions_array <<< "$PROVIDED_ALJIBE_EXTENSIONS"

    for provided_extension in "${provided_extensions_array[@]}"; do
      if [[ ! " ${available_aljibe_extensions[*]} " == *" ${provided_extension} "* ]]; then
        echo "Warning: unknown extension '${provided_extension}' ignored. Available extensions: ${available_aljibe_extensions[*]}" >&2
      fi
    done

    # shellcheck disable=SC2034
    local result=()
    for extension in "${available_aljibe_extensions[@]}"; do
      local found=false
      for provided_extension in "${provided_extensions_array[@]}"; do
        if [ "$extension" == "$provided_extension" ]; then
          found=true
          break
        fi
      done
      if [ "$found" == "true" ]; then
        result+=("true")
      else
        result+=("false")
      fi
    done
  fi

  for i in "${!available_aljibe_extensions[@]}"; do
    local current="${available_aljibe_extensions[i]}"
    # shellcheck disable=SC2154
    if [ "${result[i]}" == "true" ]; then
      echo "Installing $current"
      ddev add-on get "$current"
    else
      local item_installed
      local item_name
      item_name=$(basename "$current")
      item_installed=$(ddev add-on list --installed | grep -ic "$item_name" || true)

      if [ "$item_installed" -ne 0 ]; then
        echo "Removing $current"
        ddev add-on remove "$current"
      fi
    fi
  done
}


# Start DDEV environment.
#
# Starts the DDEV container for the project.
ddev_start() {
  ddev start -y
}

# Install Composer dependencies.
#
# Runs composer install inside the DDEV container to install all project
# dependencies defined in composer.json.
composer_install() {
  ddev composer install
}

# Setup GrumPHP.
#
# Initializes GrumPHP git hooks for code quality checks on commits. Skipped
# when the project is not a git repository. In that case GrumPHP's Composer
# plugin has already run git:init during composer install, creating a stray
# .git/hooks folder, so remove it (and .git, only if it is then empty).
grumphp_setup() {
  if ! git -C "${DDEV_APPROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Not a git repository, skipping GrumPHP git hooks setup."
    echo "Once the repository is initialized, set them up with: ddev exec grumphp git:init"
    if [ -d "${DDEV_APPROOT}/.git/hooks" ]; then
      rm -rf "${DDEV_APPROOT}/.git/hooks"
      rmdir "${DDEV_APPROOT}/.git" 2>/dev/null || true
    fi
    return
  fi
  ddev exec grumphp git:init
}

# Install Drupal.
#
# Installs Drupal using drush site-install with the appropriate profile.
drupal_install() {

  if [ -z "$INSTALL_DRUPAL" ]; then
    if [ "$AUTO" == "0" ]; then
      display_yesno_question "Do you want to install Drupal?"
      read -r SHOULD_INSTALL

      if answer_is_no "$SHOULD_INSTALL"; then
        INSTALL_DRUPAL=0
      fi
    fi
    INSTALL_DRUPAL=${INSTALL_DRUPAL:-1}
  fi

  if [ "$INSTALL_DRUPAL" == "1" ]; then

    if [ -z "$INSTALL_PROFILE" ]; then
      if [ "$AUTO" == "0" ]; then
        AVAILABLE_PROFILES=("Minimal" "Standard" "Umami demo")

        while [ -z "$INSTALL_PROFILE" ] && [ "$TESTING_MODE" != "1" ]; do
          display_question "What install profile you want to install ('Minimal' is recommended for development)?"
          echo ""
          select PROFILE in "${AVAILABLE_PROFILES[@]}"; do
            case $PROFILE in
              "Minimal")
                INSTALL_PROFILE="minimal"
                ;;
              "Standard")
                INSTALL_PROFILE="standard"
                ;;
              "Umami demo")
                INSTALL_PROFILE="demo_umami"
                ;;
              *)
                echo "Invalid option. Please select a valid profile."
                continue
                ;;
            esac
            break
          done
        done
      fi
      INSTALL_PROFILE=${INSTALL_PROFILE:-$DEFAULT_PROFILE}
    fi

    echo "Installing profile $INSTALL_PROFILE"
    ddev drush -y si "$INSTALL_PROFILE"
    ddev drush cr
  fi
}

# Create behat directories
behat_setup() {
  local BEHAT_DIR="./web/sites/default/files/behat"
  local BEHAT_DIR_ERRORS="$BEHAT_DIR/errors"

  if [ ! -d "$BEHAT_DIR" ]; then
    mkdir -p "$BEHAT_DIR"
    chmod 755 "$BEHAT_DIR"
  fi

  if [ ! -d "$BEHAT_DIR_ERRORS" ]; then
    mkdir -p "$BEHAT_DIR_ERRORS"
    chmod 755 "$BEHAT_DIR_ERRORS"
  fi
}

